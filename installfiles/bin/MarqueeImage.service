[Unit]
Description=Marquee Image
After=graphical.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
Environment="WAYLAND_DISPLAY=wayland-0"
Environment="XDG_RUNTIME_DIR=/run/user/__UID__"
Environment="Image=__HOME__/marquees/blank.png"
EnvironmentFile=-__HOME__/bin/imagearg.txt
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do [ -S /run/user/__UID__/wayland-0 ] && exit 0; sleep 2; done; exit 1'
ExecStart=/usr/bin/mpv --no-audio --border=no --video-rotate=270 --fullscreen --idle=yes --vo=gpu --hwdec=no --background=none --title=mpv-image --image-display-duration=inf --input-ipc-server=/tmp/mpv-image.sock
Restart=no
#ExecStop=-pkill -f "mpv.*mpv-image"

[Install]
WantedBy=graphical.target
