[Unit]
Description=Marquee Video
After=graphical.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
Environment="WAYLAND_DISPLAY=wayland-0"
Environment="XDG_RUNTIME_DIR=/run/user/__UID__"
Environment="Video=__HOME__/marquees/default_control.mp4"
EnvironmentFile=-__HOME__/bin/videoarg.txt
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do [ -S /run/user/__UID__/wayland-0 ] && exit 0; sleep 2; done; exit 1'
ExecStart=/usr/bin/mpv --loop --no-audio --fullscreen --title=mpv-video --idle=yes --image-display-duration=inf  --input-ipc-server=/tmp/mpv-video.sock "${Video}"
Restart=no
RestartSec=2
#ExecStop=-pkill -f "mpv.*mpv-video"

[Install]
WantedBy=graphical.target
