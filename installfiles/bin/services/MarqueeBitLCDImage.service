[Unit]
Description=Marquee BitLCD Image Overlay
After=graphical.target

[Service]
Type=simple
User=pi
Group=pi
Environment="WAYLAND_DISPLAY=wayland-0"
Environment="XDG_RUNTIME_DIR=/run/user/1000"
Environment="Image=/home/pi/marquees/default.png"
EnvironmentFile=-/home/pi/bin/marqueearg_img.txt
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do [ -S /run/user/1000/wayland-0 ] && exit 0; sleep 2; done; exit 1'
ExecStart=/usr/bin/mpv --no-audio --fullscreen --border=no --loop-file=inf --vo=gpu-next  --no-input-cursor --no-input-default-bindings --idle --title="bitlcd-marquee-image" --video-align-y=-1 --video-unscaled=yes  --image-display-duration=inf  --input-ipc-server=/tmp/mpv-bitlcd-image.sock "${Image}"
Restart=no
#ExecStop=-pkill -f "mpv.*bitlcd-marquee-image"

[Install]
WantedBy=graphical.target
