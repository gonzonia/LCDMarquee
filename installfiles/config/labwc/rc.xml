<?xml version="1.0"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <windowRules>
    <windowRule title="bitlcd-marquee">
      <action name="MoveToOutput" output="HDMI-A-2"/>
      <action name="ToggleFullscreen"/>
    </windowRule>
    <windowRule title="bitlcd-marquee-image">
      <action name="MoveToOutput" output="HDMI-A-2"/>
      <action name="RaiseToTop"/>
    </windowRule>
    <windowRule identifier="mpv-image" matchFrom="title" type="normal">
      <action name="MoveToOutput">
        <output>HDMI-A-1</output>
      </action>
      <action name="ToggleFullscreen"/>
      <action name="RaiseToTop"/>
    </windowRule>
    <windowRule identifier="mpv-video" matchFrom="title" type="normal">
      <action name="MoveToOutput">
        <output>HDMI-A-1</output>
      </action>
      <action name="ToggleFullscreen"/>
    </windowRule>
  </windowRules>
</openbox_config>
